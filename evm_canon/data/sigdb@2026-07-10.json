{
  "version": "sigdb@2026-07-10",
  "comment": "Curated function-signature set. Selectors are DERIVED at load time (keccak of sig) - never stored, so they cannot drift. 'names' must match the arity of the signature. 'standard' is a label, not a guarantee: selectors are shared across standards (e.g. approve(address,uint256) is ERC-20 and ERC-721).",
  "functions": [
    {"sig": "transfer(address,uint256)", "names": ["to", "amount"], "standard": "ERC-20"},
    {"sig": "approve(address,uint256)", "names": ["spender", "amount"], "standard": "ERC-20/721"},
    {"sig": "transferFrom(address,address,uint256)", "names": ["from", "to", "amount"], "standard": "ERC-20/721"},
    {"sig": "permit(address,address,uint256,uint256,uint8,bytes32,bytes32)", "names": ["owner", "spender", "value", "deadline", "v", "r", "s"], "standard": "EIP-2612"},
    {"sig": "safeTransferFrom(address,address,uint256)", "names": ["from", "to", "tokenId"], "standard": "ERC-721"},
    {"sig": "safeTransferFrom(address,address,uint256,bytes)", "names": ["from", "to", "tokenId", "data"], "standard": "ERC-721"},
    {"sig": "setApprovalForAll(address,bool)", "names": ["operator", "approved"], "standard": "ERC-721/1155"},
    {"sig": "safeTransferFrom(address,address,uint256,uint256,bytes)", "names": ["from", "to", "id", "amount", "data"], "standard": "ERC-1155"},
    {"sig": "safeBatchTransferFrom(address,address,uint256[],uint256[],bytes)", "names": ["from", "to", "ids", "amounts", "data"], "standard": "ERC-1155"},
    {"sig": "deposit()", "names": [], "standard": "WETH"},
    {"sig": "withdraw(uint256)", "names": ["amount"], "standard": "WETH"},
    {"sig": "mint(address,uint256)", "names": ["to", "amount"], "standard": "mintable"},
    {"sig": "burn(uint256)", "names": ["amount"], "standard": "burnable"},
    {"sig": "swapExactTokensForTokens(uint256,uint256,address[],address,uint256)", "names": ["amountIn", "amountOutMin", "path", "to", "deadline"], "standard": "UniswapV2"},
    {"sig": "swapExactETHForTokens(uint256,address[],address,uint256)", "names": ["amountOutMin", "path", "to", "deadline"], "standard": "UniswapV2"},
    {"sig": "swapExactTokensForETH(uint256,uint256,address[],address,uint256)", "names": ["amountIn", "amountOutMin", "path", "to", "deadline"], "standard": "UniswapV2"},
    {"sig": "exactInputSingle((address,address,uint24,address,uint256,uint256,uint256,uint160))", "names": ["params"], "standard": "UniswapV3"},
    {"sig": "exactInput((bytes,address,uint256,uint256,uint256))", "names": ["params"], "standard": "UniswapV3"},
    {"sig": "multicall(bytes[])", "names": ["data"], "standard": "multicall"},
    {"sig": "multicall(uint256,bytes[])", "names": ["deadline", "data"], "standard": "multicall"},
    {"sig": "approve(address,address,uint160,uint48)", "names": ["token", "spender", "amount", "expiration"], "standard": "Permit2"},
    {"sig": "transferOwnership(address)", "names": ["newOwner"], "standard": "Ownable"},
    {"sig": "renounceOwnership()", "names": [], "standard": "Ownable"},
    {"sig": "upgradeTo(address)", "names": ["newImplementation"], "standard": "proxy"},
    {"sig": "upgradeToAndCall(address,bytes)", "names": ["newImplementation", "data"], "standard": "proxy"},
    {"sig": "execute(bytes,bytes[],uint256)", "names": ["commands", "inputs", "deadline"], "standard": "UniversalRouter"},
    {"sig": "claim()", "names": [], "standard": "distributor"},
    {"sig": "stake(uint256)", "names": ["amount"], "standard": "staking"},
    {"sig": "increaseAllowance(address,uint256)", "names": ["spender", "addedValue"], "standard": "ERC-20"},
    {"sig": "decreaseAllowance(address,uint256)", "names": ["spender", "subtractedValue"], "standard": "ERC-20"}
  ]
}
